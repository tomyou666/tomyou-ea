{
  // IntelliSense を使用して利用可能な属性を学べます。
  // 既存の属性の説明をホバーして表示します。
  // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "現在のファイル実行（デバッグモード）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/",
      "env": {
        "IS_DEBUG": "TRUE"
      },
    },
    {
      "name": "現在のファイル実行",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/",
    },
    {
      "name": "fastapi起動（デバッグモード）",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/server",
      "env": {
        "IS_DEBUG": "TRUE"
      },
      "args": [
        "dev",
        "app_server/main.py",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
      ],
    },
    {
      "name": "fastapi起動",
      "type": "debugpy",
      "request": "launch",
      "module": "fastapi",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/server",
      "args": [
        "dev",
        "app_server/main.py",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
      ],
    },
    {
      "name": "スキーマ作成",
      "type": "debugpy",
      "request": "launch",
      "program": "./app_server/main_db_schema_generator.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "IS_DEBUG": "TRUE"
      },
    },
    {
      "name": "テスト実行",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "-s",
        "-v"
      ],
      "env": {
        "IS_DEBUG": "TRUE"
      },
    },
  ]
}
